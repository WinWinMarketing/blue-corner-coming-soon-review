# Copy to /etc/blue-corner/api.env on the server, fill in, then:
#   sudo chown root:root /etc/blue-corner/api.env
#   sudo chmod 600 /etc/blue-corner/api.env
#
# NEVER commit the filled-in version. systemd reads this as root before dropping
# to the `bluecorner` user, so the service account itself cannot read the key.

# From the Resend dashboard. Starts "re_".
RESEND_API_KEY=

# Must be an address at a domain VERIFIED in Resend, or every send fails 4xx.
# During pre-DNS verification use Resend's sandbox sender, which needs no
# verified domain:
#   EMAIL_FROM=onboarding@resend.dev
# After the Blue Corner domain verifies, switch to:
#   EMAIL_FROM=The Blue Corner <noreply@example.ca>
EMAIL_FROM=onboarding@resend.dev

# Where signup notifications land. Prefer a dedicated mailbox over a shared
# personal one: these messages contain health-adjacent personal information.
# Target state: sharf@thebluecorner.ca, once that address can actually receive.
EMAIL_TO=

# Reply-To on the CONFIRMATION email sent to the person who signed up.
# Target state: noreply@thebluecorner.ca, forwarded to Sharf so he can reply to
# people directly. Until that forwarding exists, point this at a mailbox that
# genuinely receives, or every reply bounces.
REPLY_TO=

# Set to false to stop the confirmation email without a code change. It is the
# only outbound message aimed at the public, so it needs an off switch.
AUTOREPLY_ENABLED=true

# The site's own origin. A POST carrying any other Origin header is refused.
# Must include the scheme and no trailing slash, e.g. https://thebluecorner.ca
ALLOWED_ORIGIN=

# Optional. Defaults shown.
# PORT=8787
# FAILED_LOG=/var/lib/blue-corner/failed-signups.jsonl
